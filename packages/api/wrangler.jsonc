{
  "name": "demo-locker-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "r2_buckets": [
    {
      "binding": "DEMOS_BUCKET",
      "bucket_name": "demo-locker-demos"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demo-locker-db",
      "database_id": "0ea573b2-861c-482c-a9c7-de5335d29fa0",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "assets": {
    "directory": "../player/dist"
  }
  // Limit vars (MAX_PLAYLISTS, MAX_STORAGE_BYTES, MAX_COLLABORATORS) are set
  // as env vars via wrangler or the dashboard. The database and bucket are
  // bindings above — there are no secrets on this deployment.
}
