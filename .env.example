# Defaults are zero-dependency: with neither DATABASE_URL nor S3_ENDPOINT set,
# the API runs on an embedded PGlite database and local-disk storage, both under
# DATA_DIR. That's what the standalone image and `npx demo-locker` use. On the
# Cloudflare target the database and bucket are bindings — no env vars at all.
#
# Uncomment the blocks below only for the Postgres + S3 path (docker compose,
# or a from-source install). See docs/self-hosting.md.

# Where the database file and audio files live in zero-dependency mode.
DATA_DIR=./data

# API server
PORT=3001

# Database — Postgres. Leave unset to use the embedded PGlite database.
# docker compose sets this for you; only fill it in for a from-source install.
# DATABASE_URL=postgres://demolocker:demolocker@localhost:5432/demolocker

# Web build — the origin the built frontend calls for the API.
# Set this to your API's reachable address (e.g. http://YOUR-HOST:3001)
# before `docker compose build` if serving beyond localhost.
# VITE_API_URL=http://localhost:3001

# S3-compatible storage — Cloudflare R2, MinIO for local dev. Leave unset to
# store audio on local disk under DATA_DIR. docker compose sets these for you.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=demos
# S3_ACCESS_KEY=demolocker
# S3_SECRET_KEY=demolocker
# S3_REGION=auto

# Limits — leave unset (or 0) for unlimited (self-hosted default)
# Only set these for the hosted version
# MAX_PLAYLISTS=1
# MAX_STORAGE_BYTES=524288000
# MAX_COLLABORATORS=4
