# Demo Locker configuration. Every setting here is optional — an instance with
# none of them runs zero-dependency: embedded SQLite plus local-disk storage,
# both under DATA_DIR. That is what the standalone image and `npx demo-locker`
# use. On the Cloudflare target the database and bucket are Worker bindings, so
# none of the storage settings apply there.

# Where the SQLite database file and the audio files live.
DATA_DIR=./data

# API server
PORT=3001

# Web build — the origin the built frontend calls for the API.
# Set this to your API's reachable address (e.g. http://YOUR-HOST:3001)
# before `docker compose build` if serving beyond localhost.
# VITE_API_URL=http://localhost:3001

# S3-compatible storage — Cloudflare R2, MinIO for local dev. Leave unset to
# store audio on local disk under DATA_DIR. docker compose sets these for you.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=demos
# S3_ACCESS_KEY=demolocker
# S3_SECRET_KEY=demolocker
# S3_REGION=auto

# --- Access ---------------------------------------------------------------
# Registration closes automatically once the instance has one account: the
# first signup claims the locker and later ones get a 403. Collaborators
# arrive by share link and need no account, so most instances want this left
# alone. Set to true only for a genuinely shared instance.
# ALLOW_SIGNUP=true

# --- Limits ---------------------------------------------------------------
# Largest single upload. Defaults to 1GB when unset — not unlimited.
# MAX_UPLOAD_BYTES=1073741824

# The rest are unlimited when unset (the self-hosted default); set them for a
# shared or hosted instance.
# MAX_PLAYLISTS=1
# MAX_STORAGE_BYTES=524288000
# Collaborators per locker — people sharing your library, counting invites
# you have sent but nobody has redeemed yet.
# MAX_COLLABORATORS=4
# Share links one playlist may have. Separate from the line above: capping
# seats must not cap links. (Before 0.2.13 MAX_COLLABORATORS did both.)
# MAX_SHARE_LINKS=10
